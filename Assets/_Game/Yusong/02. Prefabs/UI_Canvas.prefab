  m_text: "\uC5F0\uC18D \uCC98\uCE58\uB85C \uCF64\uBCF4\uB97C \uC313\uC73C\uBA74
    \uD53C\uBC84\uD0C0\uC784(\uAD11\uC5ED \uD074\uB9AD)\uC774 \uBC1C\uB3D9\uD569\uB2C8\uB2E4.\n\uCD08\uB85D\uC0C9
