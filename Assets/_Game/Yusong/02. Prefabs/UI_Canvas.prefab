  m_text: "<color=#8CFF59>\uCD08\uB85D\uC0C9 '\uC774\uB984\uBBF8\uC815'</color>\uC5D0
    \uC801\uC774 \uB2FF\uAE30 \uC804\uC5D0 \uBA3C\uC800 \uCC98\uCE58\uD574\uC11C
    \uC9C0\uCF1C\uC8FC\uC138\uC694 \u2014 \uC0B4\uC544\uB0A8\uC740 \uCCB4\uB825\uB9CC\uD07C
    <b>+1000~3000</b>\uC810, \uD30C\uAD34\uB418\uBA74 <b>-2000</b>\uC810!\n\uC5F0\uC18D
    \uCC98\uCE58\uB85C \uCF64\uBCF4\uB97C \uC313\uC73C\uBA74 \uD53C\uBC84\uD0C0\uC784(\uAD11\uC5ED
    \uD074\uB9AD) \uBC1C\uB3D9, \uCC98\uCE58 \uC810\uC218 <color=#4DFF66>2\uBC30</color>\n\uB9C8\uC9C0\uB9C9
    \uC6E8\uC774\uBE0C\uC5D0\uB294 \uAC15\uB825\uD55C \uBCF4\uC2A4\uAC00 \uB4F1\uC7A5\uD569\uB2C8\uB2E4."
  m_isRightToLeft: 0
