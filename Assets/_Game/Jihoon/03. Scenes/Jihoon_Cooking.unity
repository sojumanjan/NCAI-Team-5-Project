  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialPanelUI
  openView: {fileID: 310859988}
  closedView: {fileID: 618461376}
  bodyText: {fileID: 128785446}
  titleText: {fileID: 171928469}
  hands: {fileID: 2064529884}
  toggleKey: 30
  openOnStart: 1
  hideWhenDone: 1
  sequences:
  - title: "\uC544\uBA54\uB9AC\uCE74\uB178 \uB9CC\uB4E4\uAE30"
    steps:
    - text: "\uCEE4\uD53C \uCF69\uC744 \uC190\uC5D0 \uB4E4\uACE0 \uCEE4\uD53C \uBA38\uC2E0\uC5D0
        \uB123\uC73C\uC138\uC694"
      goal: 1
      station: 0
      items:
      - {fileID: 11400000, guid: 6b18293749d47694ebd5106b98888008, type: 2}
    - text: "E\uD0A4\uB85C \uCEE4\uD53C\uBA38\uC2E0\uC744 \uC791\uB3D9\uC2DC\uD0A4\uC138\uC694."
      goal: 2
      station: 0
      items: []
    - text: "\uC644\uC131\uB41C \uCEE4\uD53C\uB97C \uAEBC\uB0B4\uC138\uC694."
      goal: 0
      station: 0
      items:
      - {fileID: 11400000, guid: d4c579004f3cc634a8f276872110da45, type: 2}
  - title: "\uC624\uB80C\uC9C0 \uC5D0\uC774\uB4DC \uB9CC\uB4E4\uAE30"
    steps:
    - text: "\uB0C9\uC7A5\uACE0\uC5D0\uC11C \uC624\uB80C\uC9C0\uB97C \uAEBC\uB0B4\uC138\uC694."
      goal: 0
      station: 0
      items:
      - {fileID: 11400000, guid: 2ba749d269292724ab7f631b00acd5e5, type: 2}
    - text: "\uC624\uB80C\uC9C0\uB97C \uBE14\uB80C\uB354\uC5D0 \uB123\uC73C\uC138\uC694."
      goal: 1
      station: 2
      items:
      - {fileID: 11400000, guid: 2ba749d269292724ab7f631b00acd5e5, type: 2}
    - text: "E\uD0A4\uB97C \uAFB9 \uB20C\uB7EC \uBE14\uB80C\uB354\uB97C \uC791\uB3D9\uC2DC\uD0A4\uC138\uC694."
      goal: 2
      station: 2
      items: []
    - text: "\uC644\uC131\uB41C \uC624\uB80C\uC9C0 \uC5D0\uC774\uB4DC\uB97C \uAEBC\uB0B4\uC138\uC694."
      goal: 0
      station: 0
      items:
      - {fileID: 11400000, guid: 8d3790c67ddc3874383a93a2f545688e, type: 2}
  - title: "\uC2A4\uCF58 \uB9CC\uB4E4\uAE30"
    steps:
    - text: "\uBBF9\uC11C\uAE30\uC5D0 \uB2EC\uAC40, \uBC84\uD130, \uBC00\uAC00\uB8E8\uB97C
        \uB123\uC73C\uC138\uC694."
      goal: 1
      station: 4
      items:
      - {fileID: 11400000, guid: 6a792e318c7a4034189029b2cb85602a, type: 2}
      - {fileID: 11400000, guid: 80a0cb64d7fc3a545ab3363397638a8c, type: 2}
      - {fileID: 11400000, guid: a4a6fc0b6cd7f1e4cbc396b5f124a14d, type: 2}
    - text: "E\uD0A4\uB97C \uAFB9 \uB20C\uB7EC \uBBF9\uC11C\uB97C \uC791\uB3D9\uC2DC\uD0A4\uC138\uC694."
      goal: 2
      station: 4
      items: []
    - text: "\uBC18\uC8FD\uC744 \uAEBC\uB0B4 \uC624\uBE10\uC5D0 \uB123\uC73C\uC138\uC694."
      goal: 1
      station: 1
      items:
      - {fileID: 11400000, guid: aa6febabe1068914daed02668a081055, type: 2}
    - text: "\uC624\uBE10 \uBB38\uC744 \uB2EB\uACE0 E\uD0A4\uB97C \uB20C\uB7EC \uC624\uBE10\uC744
        \uC791\uB3D9\uC2DC\uD0A4\uC138\uC694."
      goal: 2
      station: 1
      items: []
    - text: "\uC644\uC131\uB41C \uC2A4\uCF58\uC744 \uAEBC\uB0B4\uC138\uC694."
      goal: 0
      station: 0
      items:
      - {fileID: 11400000, guid: e028dc49265b2af46b946b420017a0b8, type: 2}
  - title: "\uC7A5\uC0AC \uC2DC\uC791\uD558\uAE30"
    steps:
    - text: "\uCE74\uC6B4\uD130 \uC606 \uBC84\uD2BC\uC73C\uB85C \uB09C\uC774\uB3C4\uB97C
        \uC120\uD0DD\uD558\uC138\uC694."
      goal: 6
      station: 0
      items: []
    - text: "\uB09C\uC774\uB3C4 \uC544\uB798\uC788\uB294 \uBC84\uD2BC\uC73C\uB85C
        \uC154\uD130\uB97C \uC62C\uB824 \uC7A5\uC0AC\uB97C \uC2DC\uC791\uD558\uC138\uC694."
      goal: 3
      station: 0
      items: []
    - text: "21:00\uAE4C\uC9C0 \uC190\uB2D8\uC744 \uACC4\uC18D\uD574\uC11C \uB9DE\uC774\uD558\uC138\uC694.
        (\uD3C9\uC810 4.0\uC774\uC0C1 \uD074\uB9AC\uC5B4)"
      goal: 4
      station: 0
      items: []
    - text: "\uC154\uD130 \uBB38\uC744 \uB2EB\uC544 \uC7A5\uC0AC\uB97C \uB9C8\uBB34\uB9AC\uD558\uC138\uC694."
      goal: 5
      station: 0
      items: []
